{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{public/data/**,server/**}",
      "maxDuration": 30
    }
  }
}
